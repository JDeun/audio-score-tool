# Optional command overrides. Defaults are shown.
AST_MUSCRIPTOR_CMD=muscriptor
AST_DEMUCS_CMD=demucs
AST_WHISPERX_CMD=whisperx

# Optional explicit MuseScore executable for rendering the lyric-enriched score.
# macOS example:
# AST_MUSESCORE_CMD=/Applications/MuseScore\ 4.app/Contents/MacOS/mscore

# MuScriptor model: small | medium | large
AST_MUSCRIPTOR_MODEL=medium

# WhisperX model. "small" is a conservative default for local development.
AST_WHISPERX_MODEL=small

# Optional Hugging Face token. MuScriptor weights require accepting its model license.
# HF_TOKEN=hf_...
