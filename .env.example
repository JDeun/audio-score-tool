# AudioScoreTool v0.8 developer/runtime overrides
#
# IMPORTANT: these variables are for source/development diagnostics and advanced
# overrides. A packaged desktop release must not require users to install Python,
# Node, Rust, uv, pip, LilyPond, MuseScore, or other developer tools manually.

# Usage mode controls model-license policy.
# personal: quality-first; MuScriptor-large may be selected.
# commercial: CC BY-NC weights are blocked.
AST_USAGE_MODE=personal

# Optional explicit transcription provider override: mt3_infer | muscriptor | native
# AST_TRANSCRIPTION_ENGINE=muscriptor

# Development overrides for transcription runtimes.
AST_MT3_INFER_CMD=mt3-infer
AST_MT3_MODEL=yourmt3
AST_MUSCRIPTOR_CMD=muscriptor
AST_MUSCRIPTOR_MODEL=large
AST_NATIVE_ENGINE_CMD=audio-score-native
# AST_NATIVE_CHECKPOINT=/absolute/path/to/audio-score-native.pt

# Optional enrichment/component overrides for source development.
AST_DEMUCS_CMD=demucs
AST_WHISPERX_CMD=whisperx
AST_WHISPERX_MODEL=small
AST_YT_DLP_CMD=yt-dlp

# Optional source identification.
# Embedded tags are always read locally first. ISRC can use MusicBrainz when
# service usage is allowed. Acoustic fingerprint lookup additionally requires an
# app-managed Chromaprint/fpcalc component plus an AcoustID application key.
# ACOUSTID_CLIENT_KEY=your_registered_application_key
# AST_ACOUSTID_COMMERCIAL_ENTITLED=false

# OMR development override. Stable desktop distribution must provide OMR as an
# app-managed component rather than requiring a system Java/Audiveris install.
AST_AUDIVERIS_CMD=audiveris

# Optional audio-evidence validation development overrides. These do not control
# core editing/export readiness. Stable distribution should use app-managed tools.
AST_FFMPEG_CMD=ffmpeg
AST_FLUIDSYNTH_CMD=fluidsynth
# A compatible SoundFont may be user-selected for the optional resynthesis feature.
# AST_VALIDATION_SOUNDFONT=/absolute/path/to/general-midi.sf2

# Required only when a selected model provider uses gated Hugging Face weights.
# HF_TOKEN=hf_...

# LLM validation is optional and configured in-app. API-key VALUES are never
# persisted; only the environment-variable NAME is saved, e.g. OPENAI_API_KEY.
# Local OpenAI-compatible example: http://127.0.0.1:11434/v1
