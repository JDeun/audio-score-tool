# AudioScoreTool v0.7 runtime overrides

# Transcription provider: mt3_infer | muscriptor | native
AST_TRANSCRIPTION_ENGINE=mt3_infer

# Recommended multi-instrument provider.
# MR-MT3 is the commercial-default candidate because both upstream code and the
# published checkpoint are marked MIT. YourMT3 remains an optional quality experiment.
AST_MT3_INFER_CMD=mt3-infer
AST_MT3_MODEL=mr_mt3

# MuScriptor compatibility provider (public weights are non-commercial)
AST_MUSCRIPTOR_CMD=muscriptor
AST_MUSCRIPTOR_MODEL=medium

# AudioScore Native R&D provider
AST_NATIVE_ENGINE_CMD=audio-score-native
# AST_NATIVE_CHECKPOINT=/absolute/path/to/audio-score-native.pt

# Lyrics / source tools
AST_DEMUCS_CMD=demucs
AST_WHISPERX_CMD=whisperx
AST_WHISPERX_MODEL=small
AST_YT_DLP_CMD=yt-dlp

# MuseScore 4 renderer / MIDI -> MusicXML converter
# macOS example:
# AST_MUSESCORE_CMD=/Applications/MuseScore\ 4.app/Contents/MacOS/mscore

# Only required when the MuScriptor provider is selected.
# Accept the upstream model license before setting a token.
# HF_TOKEN=hf_...
