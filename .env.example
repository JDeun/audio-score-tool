# AudioScoreTool v0.8 runtime overrides

# Usage mode controls license policy.
# personal: quality-first; MuScriptor-large is allowed and preferred.
# commercial: CC BY-NC weights are blocked.
AST_USAGE_MODE=personal

# Optional explicit provider override: mt3_infer | muscriptor | native
# If omitted, personal mode selects muscriptor and commercial mode selects mt3_infer.
# AST_TRANSCRIPTION_ENGINE=muscriptor

# Quality-first MT3 fallback / commercial candidate.
AST_MT3_INFER_CMD=mt3-infer
AST_MT3_MODEL=yourmt3

# Highest-quality personal/non-commercial default.
# MuScriptor code is MIT; public weights are CC BY-NC 4.0.
AST_MUSCRIPTOR_CMD=muscriptor
AST_MUSCRIPTOR_MODEL=large

# AudioScore Native R&D provider
AST_NATIVE_ENGINE_CMD=audio-score-native
# AST_NATIVE_CHECKPOINT=/absolute/path/to/audio-score-native.pt

# Lyrics / source tools
AST_DEMUCS_CMD=demucs
AST_WHISPERX_CMD=whisperx
AST_WHISPERX_MODEL=small
AST_YT_DLP_CMD=yt-dlp

# MuseScore 4 renderer / MIDI -> MusicXML converter
# macOS example:
# AST_MUSESCORE_CMD=/Applications/MuseScore\ 4.app/Contents/MacOS/mscore

# Required when MuScriptor is selected: accept the model license and authenticate.
# HF_TOKEN=hf_...

# LLM validation is configured in-app. API keys are never persisted; only the
# environment-variable NAME is saved, e.g. OPENAI_API_KEY.
# Local OpenAI-compatible example: http://127.0.0.1:11434/v1
