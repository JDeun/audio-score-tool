{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default AudioScoreTool desktop capability",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://docs.astral.sh/uv/getting-started/installation/" },
        { "url": "https://huggingface.co/settings/tokens" },
        { "url": "https://huggingface.co/oauth/device" },
        { "url": "https://huggingface.co/MuScriptor/muscriptor-large" },
        { "url": "https://lilypond.org/download.html" },
        { "url": "https://acoustid.org/chromaprint" },
        { "url": "https://audiveris.github.io/audiveris/" },
        { "url": "https://ffmpeg.org/download.html" },
        { "url": "https://www.fluidsynth.org/download/" }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/audio-score-backend",
          "sidecar": true
        }
      ]
    }
  ]
}
